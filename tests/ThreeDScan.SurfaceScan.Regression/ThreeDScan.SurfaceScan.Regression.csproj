<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the real pure-geometry sources without scanner DLLs, EF, WPF or an API host. -->
    <Compile Include="../../ThreeDScan.Domain/Models/*.cs" Link="Domain/%(Filename)%(Extension)" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/Models/*.cs" Link="Export/Models/%(Filename)%(Extension)" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/AngleSteelExtractor.cs" Link="Export/AngleSteelExtractor.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/GroundPlaneEstimator*.cs" Link="Export/%(Filename)%(Extension)" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/MeasuredSurfaceRecovery*.cs" Link="Export/%(Filename)%(Extension)" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/LocalSupportPlaneSeparation*.cs" Link="Export/%(Filename)%(Extension)" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/WingPlaneSegmentation*.cs" Link="Export/%(Filename)%(Extension)" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/GeometryFitting.cs" Link="Export/GeometryFitting.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/SegmentProcessor.cs" Link="Export/SegmentProcessor.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/CalibrationMath.cs" Link="Export/CalibrationMath.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/CompatibleGridSet.cs" Link="Export/CompatibleGridSet.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/GridCell.cs" Link="Export/GridCell.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/RigidTransforms.cs" Link="Export/RigidTransforms.cs" />
    <Compile Include="../../ThreeDScan.Infrastructure/Export/ScanPly.cs" Link="Export/ScanPly.cs" />
  </ItemGroup>
</Project>
