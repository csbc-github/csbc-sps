{
  // 僅在 ASPNETCORE_ENVIRONMENT=Development 時覆寫 appsettings.json 對應鍵，其餘沿用正式檔。
  "Calibration": {
    // 開發時回診斷欄位（覆寫正式檔的 Production）。
    "ResponseMode": "Debug"
  },
  "Authentication": {
    // 本機開發預設不強制 Bearer。要測 IdP 時改 true 並重啟 Api。
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
