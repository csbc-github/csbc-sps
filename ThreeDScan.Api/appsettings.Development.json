{
  // 僅在 ASPNETCORE_ENVIRONMENT=Development 時覆寫 appsettings.json 對應鍵，其餘沿用正式檔。
  "Scanners": {
    "SURF-CAM-01": {
      // 有值時 surface-from-file 可省略 captureDirectory，改讀此資料夾的 raw_scene.ply。
      "OfflineCaptureDirectory": ""
    },
    "SURF-CAM-02": {
      // 割切區測試：與噴印共用同一份 raw_scene.ply；產出會寫到 export/SURF-CAM-02。
      "OfflineCaptureDirectory": ""
    }
  },
  "SurfaceScan": {
    // 開發預設仍真掃；要測離線再改 true。
    "UseExistingPly": false,
    // 與 Scanners OfflineCaptureDirectory 同一份測試 raw_scene.ply。
    "ExistingPlyPath": ""
  },
  "LineScan": {
    "IpControlRoot": "",
    // 只由此 JSON 開關決定位移來源：true 模擬往前，false 使用真實 Encoder。
    "EncoderSimulation": {
      "Enabled": false,
      "ForwardSpeedMmPerSec": 100
    }
  },
  "Calibration": {
    // 開發時回診斷欄位（覆寫正式檔的 Production）。
    "ResponseMode": "Debug"
  },
  "Authentication": {
    // 本機開發預設不強制 Bearer。要測 IdP 時改 true 並重啟 Api。
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      // 開發環境預設日誌等級。
      "Default": "Information",
      // 壓低 ASP.NET 框架日誌。
      "Microsoft.AspNetCore": "Warning",
      // 不輸出每筆 EF SQL（line/live 輪詢會刷屏）。
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
