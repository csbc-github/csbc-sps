{
  // SQL Server。Infrastructure 優先讀 ThreeDScan，沒有再讀 DefaultConnection。
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;",
    "ThreeDScan": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;"
  },
  "Storage": {
    // 校正預覽圖、靜態檔根目錄。Api 掛成 /calibration-preview-files；子目錄為 {ScannerId}/program_{n}/previews。
    "ContentsRoot": "D:\\3DScan\\contents"
  },
  // 鍵名 = scannerId（API 的 scannerId 須對到這裡）。值為該台 LJ 連線。
  "Scanners": {
    "SURF-CAM-01": {
      "Ip": "192.168.0.1",
      // LJ 指令埠（預設 24691）。
      "Port": 24691,
      // LJ 高速影像埠（預設 24692）。
      "HighSpeedPort": 24692,
      // 預設拍攝群組 1～16；API 省略 navigatorScanNo 時用此值。會轉成 SDK programNo（值 - 1）。
      "NavigatorScanNo": 1,
      // 寫入補償歷程的產線區域（例如 printing / cutting）。
      "MachineArea": "printing"
    },
    "SURF-CAM-02": {
      "Ip": "192.168.0.2",
      "Port": 24691,
      "HighSpeedPort": 24692,
      "NavigatorScanNo": 1,
      "MachineArea": "cutting"
    }
  },
  "Calibration": {
    // Production：API 只回規格欄位。Debug：多回診斷欄位。
    "ResponseMode": "Production",
    // true：不連掃描器、不寫補償／Ref，回固定範例供串接。測完請改回 false。
    "TestMode": false,
    // 寫入 OperationLog 的呼叫端識別。
    "ClientId": "台船",
    // 兩次拍攝反推掃描器 Z 之差（zDeviation）須小於本值（mm）才寫補償。
    "ZDeviationThresholdMm": 1.0,
    // 儀器校正兩次拍攝中間，task 暫存在 DB 的有效分鐘數。
    "InstrumentTaskTtlMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      // 預設日誌等級。
      "Default": "Information",
      // 壓低 ASP.NET 框架日誌。
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // 允許的 Host 標頭；* 表示不限制。
  "AllowedHosts": "*",
  "Authentication": {
    // true：JwtBearer 驗 Bearer，所有 Controller 需授權。false：本機可不帶 token。
    "Enabled": true,
    // IdP issuer 基底（JwtBearer 由此抓 JWKS／metadata）。
    "Authority": "https://idpapi.csbcnet.com.tw",
    // DAS OpenIdConnectProvider 交叉驗證用。JwtBearer 在 Audience 空白時不拿它驗 aud。
    "ClientId": "7b8a6387",
    // Api 的 AuthenticationOptions 未綁定此欄；JwtBearer 不需要。可留作與 IdP 對照。
    "ClientSecret": "7909b531-9176-44b2-a41e-9533bb5b8956",
    // 有填才驗證 JWT aud；空白只驗 issuer／簽章／過期。Access Token 須為 JWT，opaque 會 invalid_token。
    "Audience": "",
    // true：IdP metadata 必須走 HTTPS。
    "RequireHttpsMetadata": true
  }
}
