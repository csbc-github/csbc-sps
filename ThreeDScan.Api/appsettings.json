{
  // SQL Server。Infrastructure 優先讀 ThreeDScan，沒有再讀 DefaultConnection。
  "ConnectionStrings": {
    // 後備連線字串。
    "DefaultConnection": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;",
    // 正式使用的資料庫連線（補償歷程、工單厚度、ScanCallLog 等）。
    "ThreeDScan": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;"
  },
  "Storage": {
    // 校正預覽／Ref 與監看 GLB 指標檔根目錄（絕對路徑）。
    "ContentsRoot": "D:\\3DScan\\contents",
    // 面掃描匯出根目錄（PLY／ZIP／GLB）。相對路徑會解析到專案／執行目錄下的 export。
    "ExportRoot": "export"
  },
  "PlyProcessor": {
    // 舊固定高度門檻（mm）。ScanProcessor 改自動空隙，已不讀、不傳入。
    // "ZThresh": 12,
    // 去雜訊 voxel 邊長（mm）。相鄰格子連成一群。
    "NoiseVoxel": 3,
    // 去雜訊時，少於此點數的連通群當碎片丟掉。
    "MinNoiseSize": 200,
    // 物件分群 voxel 邊長（mm）。管線內實際分群至少用 30 mm。
    "VoxelSize": 10,
    // 物件分群最小點數；小於此的群不當成角鋼。
    "MinClusterSize": 200,
    // 可選：再扣主平面時的距離容差（mm）。RemoveDominantPlane 為 false 時不用。
    "PlaneTol": 8,
    // true：濾點後再扣一次主平面。目前關閉。
    "RemoveDominantPlane": false,
    // true：單件模式（不拆最大群）。false：分群後只留最大角鋼。
    "SinglePieceMode": false,
    // 高度場組網格的格子邊長（mm）。
    "MeshCellSize": 2,
    // STEP／GLB 擠出厚度（mm）。沒有量測、也沒有已存工單厚度時才用這個。
    "MeshThickness": 6,
    // 網格平滑次數。
    "SmoothIter": 4,
    // 網格侵蝕次數（去掉邊緣毛刺）。
    "ErodeN": 1,
    // 組網格時橋接空隙的最大格子數。過大會把遠處雜訊連上。
    "MeshBridgeFill": 30,
    // 多段拼接時段與段的 X 間距（mm）。
    "StitchGap": 0,
    // 各段依 X 範圍裁兩端的百分比。
    "StitchTrimPercent": 3,
    // true：後段 Y／Z 中位數對齊第一段。
    "StitchAlignYZ": true,
    // true：拼接後全體最低 Z 歸零。
    "StitchZFloor": true
  },
  // 鍵名 = scannerId（API 的 scannerId 須對到這裡）。值為該台 LJ 連線。
  "Scanners": {
    "SURF-CAM-01": {
      // 掃描器 IP。
      "Ip": "192.168.0.1",
      // LJ 指令埠（預設 24691）。
      "Port": 24691,
      // LJ 高速影像埠（預設 24692）。
      "HighSpeedPort": 24692,
      // 預設拍攝群組 1～16；API 省略 navigatorScanNo 時用此值。會轉成 SDK programNo（值 - 1）。
      "NavigatorScanNo": 1,
      // 寫入補償歷程的產線區域（printing / cutting）。
      "MachineArea": "printing"
    },
    "SURF-CAM-02": {
      // 掃描器 IP。
      "Ip": "192.168.0.2",
      // LJ 指令埠（預設 24691）。
      "Port": 24691,
      // LJ 高速影像埠（預設 24692）。
      "HighSpeedPort": 24692,
      // 預設拍攝群組 1～16；API 省略 navigatorScanNo 時用此值。會轉成 SDK programNo（值 - 1）。
      "NavigatorScanNo": 1,
      // 寫入補償歷程的產線區域（printing / cutting）。
      "MachineArea": "cutting"
    }
  },
  "Calibration": {
    // Production：API 只回規格欄位。Debug：多回診斷欄位。
    "ResponseMode": "Production",
    // true：不連掃描器、不寫補償／Ref，回固定範例供串接。測完請改回 false。
    "TestMode": false,
    // 寫入 OperationLog 的呼叫端識別。
    "ClientId": "台船",
    // 兩次拍攝反推掃描器 Z 之差（zDeviation）須小於本值（mm）才寫補償。
    "ZDeviationThresholdMm": 1.0,
    // 儀器校正兩次拍攝中間，task 暫存在 DB 的有效分鐘數。
    "InstrumentTaskTtlMinutes": 30
  },
  "Callback": {
    // 規格 4.5 CallbackMaxRetries：送達失敗最多再試幾次。
    "MaxRetries": 5,
    // 規格 4.5 CallbackRetryDelaySec：各次重試間隔（秒），指數退避。
    "RetryDelaySec": [ 2, 4, 8, 16, 32 ],
    // 規格 4.5 CallbackTimeoutSec：單次 POST callbackUrl 逾時（秒）。
    "TimeoutSec": 10
  },
  "Watchdog": {
    // 規格 4.2 MaxTaskDuration：start 後未 complete／abort 則自動中斷（分鐘）。
    "MaxTaskDurationMinutes": 10
  },
  "SurfaceScan": {
    // true：正式面掃描（start／segment／舊 POST /surface）改讀 ExistingPlyPath，不連掃描器。
    "UseExistingPly": false,
    // ply 檔絕對路徑；UseExistingPly 為 true 時必填。正式預設 null。
    "ExistingPlyPath": null
  },
  "LineScan": {
    // 執行 line_scan_worker.py 的 Python。
    "PythonExe": "python",
    // 既有 IP_control。空白則無法連光達；開發環境可在 appsettings.Development.json 覆寫。
    "IpControlRoot": "",
    // 橫向分件空隙，以及同一軌中間掃不到時沿滾輪的空檔 (mm)。
    "GapMm": 10,
    // 低於滾輪平面此高度的點不進入角鋼 (mm)。需高於滾輪面與基準的誤差，否則滾輪面會把相鄰角鋼接成一件。
    "MinHeightMm": 15,
    // 剔除離群值後平均的圈數。1＝不平均。原始錄製仍保留每一圈。
    "AverageScans": 20,
    // 裁切開始秒。平均前丟掉此秒之前的圈。0 表示從錄製開頭留下。
    "CropStartSeconds": 0,
    // 裁切結束秒。null 表示留到最後一圈。
    "CropEndSeconds": null,
    // 規格 RollerFlatnessTolerance。滾輪範圍內超過此值則 CAL_LINE_004 (mm)。
    "RollerFlatnessToleranceMm": 5,
    // 離開平面超過此值視為滾輪外（兩側高板，或外側就是地板）。不參與清空判定 (mm)。
    "RollerRangeDeviationMm": 15,
    // 空滾輪校正平均的截面數。
    "CalibrationFrames": 40,
    // 尺寸引擎。HankPython 呼叫 Hank measure_parts；CSharp 為同一套分件的改寫。
    "MeasurementEngine": "CSharp"
  },
  // 鍵名 = 線掃描 scannerId。與面掃描 Scanners 分開，IP／埠只給這台光達。
  "LineScanners": {
    "LINE-LIDAR-01": {
      // 光達 IP。對應 IP_control 預設。
      "Ip": "192.168.0.1",
      // CoLa B 埠。
      "Port": 2111
    }
  },
  "Logging": {
    "LogLevel": {
      // 預設日誌等級。
      "Default": "Information",
      // 壓低 ASP.NET 框架日誌。
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // 允許的 Host 標頭；* 表示不限制。
  "AllowedHosts": "*",
  "Authentication": {
    // true：JwtBearer 驗 Bearer，所有 Controller 需授權。false：本機可不帶 token。
    "Enabled": true,
    // IdP issuer 基底（JwtBearer 由此抓 JWKS／metadata）。
    "Authority": "https://idpapi.csbcnet.com.tw",
    // DAS OpenIdConnectProvider 交叉驗證用。JwtBearer 在 Audience 空白時不拿它驗 aud。
    "ClientId": "7b8a6387",
    // Api 的 AuthenticationOptions 未綁定此欄；JwtBearer 不需要。可留作與 IdP 對照。
    "ClientSecret": "7909b531-9176-44b2-a41e-9533bb5b8956",
    // 有填才驗證 JWT aud；空白只驗 issuer／簽章／過期。Access Token 須為 JWT，opaque 會 invalid_token。
    "Audience": "",
    // true：IdP metadata 必須走 HTTPS。
    "RequireHttpsMetadata": true
  }
}
