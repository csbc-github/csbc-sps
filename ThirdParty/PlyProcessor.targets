<!-- Bundles Hank ply_processor into host output: bin/.../ply_processor/ -->
<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)ply_processor\ply_processor_fixed.exe">
      <Link>ply_processor\ply_processor_fixed.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)ply_processor\browser_noop.cmd">
      <Link>ply_processor\browser_noop.cmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)ply_processor\_internal\**\*">
      <Link>ply_processor\_internal\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
