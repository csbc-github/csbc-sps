{
  // SQL Server。WPF 透過 Infrastructure 讀 ThreeDScan（補償、設定畫面）；沒有則用 DefaultConnection。
  "ConnectionStrings": {
    // 後備連線字串。
    "DefaultConnection": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;",
    // 正式使用的資料庫連線。
    "ThreeDScan": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;"
  },
  "Storage": {
    // 校正預覽／Ref 與監看 GLB 指標檔根目錄（絕對路徑）。API 與桌面須同一路徑才能自動載入 GLB。
    "ContentsRoot": "D:\\3DScan\\contents",
    // 本機掃描匯出根目錄。相對路徑相對專案根。目前本機開始掃描已註解，正式匯出走 Api 的 ExportRoot。
    "ExportRoot": "export"
  },
  "PlyProcessor": {
    // 舊固定高度門檻（mm）。ScanProcessor 改自動空隙，已不讀、不傳入。
    // "ZThresh": 12,
    // 去雜訊 voxel 邊長（mm）。相鄰格子連成一群。
    "NoiseVoxel": 3,
    // 去雜訊時，少於此點數的連通群當碎片丟掉。
    "MinNoiseSize": 200,
    // 物件分群 voxel 邊長（mm）。管線內實際分群至少用 30 mm。
    "VoxelSize": 10,
    // 物件分群最小點數；小於此的群不當成角鋼。
    "MinClusterSize": 200,
    // 可選：再扣主平面時的距離容差（mm）。RemoveDominantPlane 為 false 時不用。
    "PlaneTol": 8,
    // true：濾點後再扣一次主平面。目前關閉。
    "RemoveDominantPlane": false,
    // true：單件模式（不拆最大群）。false：分群後只留最大角鋼。
    "SinglePieceMode": false,
    // 高度場組網格的格子邊長（mm）。
    "MeshCellSize": 2,
    // STEP／GLB 擠出厚度（mm）。沒有量測、也沒有已存工單厚度時才用這個。
    "MeshThickness": 6,
    // 網格平滑次數。
    "SmoothIter": 4,
    // 網格侵蝕次數（去掉邊緣毛刺）。
    "ErodeN": 1,
    // 組網格時橋接空隙的最大格子數。過大會把遠處雜訊連上。
    "MeshBridgeFill": 30,
    // 多段拼接時段與段的 X 間距（mm）。
    "StitchGap": 0,
    // 各段依 X 範圍裁兩端的百分比。
    "StitchTrimPercent": 3,
    // true：後段 Y／Z 中位數對齊第一段。
    "StitchAlignYZ": true,
    // true：拼接後全體最低 Z 歸零。
    "StitchZFloor": true
  },
  // 鍵名 = scannerId。WPF 掃描設定／測試掃描讀這裡。
  "Scanners": {
    "SURF-CAM-01": {
      // 掃描器 IP。
      "Ip": "192.168.0.1",
      // LJ 指令埠（預設 24691）。
      "Port": 24691,
      // LJ 高速影像埠（預設 24692）。
      "HighSpeedPort": 24692,
      // 預設拍攝群組 1～16；轉 SDK programNo 時為值 - 1。
      "NavigatorScanNo": 1,
      // 產線區域；噴印區監看／設定用 printing。
      "MachineArea": "printing"
    },
    "SURF-CAM-02": {
      // 掃描器 IP。
      "Ip": "192.168.0.2",
      // LJ 指令埠（預設 24691）。
      "Port": 24691,
      // LJ 高速影像埠（預設 24692）。
      "HighSpeedPort": 24692,
      // 預設拍攝群組 1～16；轉 SDK programNo 時為值 - 1。
      "NavigatorScanNo": 1,
      // 產線區域；割切區用 cutting。
      "MachineArea": "cutting"
    }
  },
  "Calibration": {
    // Debug：顯示校正監看 Tab。Production：不顯示。
    "ResponseMode": "Production"
  },
  "LineScanner": {
    "Ip": "192.168.0.1",
    "Port": 2111
  },
  "CalibrationMonitor": {
    // false：即使 Debug 也不連 Hub。true：視窗載入後連線預覽。
    "Enabled": false,
    // SignalR Hub 位址，須對應 Api 的 /hubs/calibration-preview。
    "HubUrl": "http://localhost:5295/hubs/calibration-preview",
    // 監看畫面呼叫 Api 的基底網址。
    "ApiBaseUrl": "http://localhost:5295"
  },
  "Authentication": {
    // true：啟動先向 IdP 取 token。false：略過登入。
    "Enabled": false,
    // Interactive：開瀏覽器人員登入。ClientCredentials：用 client_id／secret 自動換票。
    "Flow": "ClientCredentials",
    // IdP issuer 基底。
    "Authority": "https://idpapi.csbcnet.com.tw",
    // 在 IdP 登錄的 Client Id（與 Api 的 ClientId 可以不同組）。
    "ClientId": "73a05119",
    // 換 token、refresh 用。甲方 IdP 需 client_secret_basic。
    "ClientSecret": "51f3197f-867d-41a6-bf65-40498af724da",
    // 僅 Interactive：本機 loopback，須事先在 IdP Client 登錄。
    "RedirectUri": "http://127.0.0.1:5005/",
    // Interactive 的 scope；含 offline_access 才通常有 refresh_token。
    "Scope": "openid profile email offline_access",
    // Client Credentials 專用 scope；空白則沿用 Scope。
    "ClientCredentialsScope": "",
    // 給 Api 驗 JWT aud 用；Api 端 Audience 空白時可留空。
    "Audience": "",
    // true：IdP metadata 必須走 HTTPS。
    "RequireHttpsMetadata": true
  }
}
