{
  // SQL Server。WPF 專案本身未讀取；與 Api 同結構，若之後共用 Infrastructure 可對齊。
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;",
    "ThreeDScan": "Server=127.0.0.1;Database=ThreeDScan;User Id=ctinfomd;Password=Ctinfo12345678;TrustServerCertificate=True;"
  },
  "Storage": {
    "ContentsRoot": "D:\\3DScan\\contents",
    "ExportRoot": "export"
  },
  "PlyProcessor": {
    "RootPath": "ply_processor",
    "Port": 8000,
    "ZThresh": 12,
    "Cell": 3,
    "NoiseVoxel": 3,
    "MinNoiseSize": 200,
    "VoxelSize": 10,
    "MinClusterSize": 200,
    "PlaneTol": 8,
    "RemoveDominantPlane": false,
    "SinglePieceMode": false,
    "MeshCellSize": 2,
    "MeshThickness": 6,
    "SmoothIter": 4,
    "ErodeN": 1,
    "MeshBridgeFill": 30
  },
  // 鍵名 = scannerId。WPF 掃描設定／測試掃描讀這裡。
  "Scanners": {
    "SURF-CAM-01": {
      "Ip": "192.168.0.1",
      "Port": 24691,
      "HighSpeedPort": 24692,
      // 預設拍攝群組 1～16；轉 SDK programNo 時為值 - 1。
      "NavigatorScanNo": 1,
      "MachineArea": "printing"
    },
    "SURF-CAM-02": {
      "Ip": "192.168.0.2",
      "Port": 24691,
      "HighSpeedPort": 24692,
      "NavigatorScanNo": 1,
      "MachineArea": "cutting"
    }
  },
  "Calibration": {
    // Debug：顯示校正監看 Tab。Production：不顯示。
    "ResponseMode": "Production"
  },
  "CalibrationMonitor": {
    // false：即使 Debug 也不連 Hub。true：視窗載入後連線預覽。
    "Enabled": false,
    // SignalR Hub 位址，須對應 Api 的 /hubs/calibration-preview。
    "HubUrl": "http://localhost:5295/hubs/calibration-preview",
    // 監看畫面呼叫 Api 的基底網址。
    "ApiBaseUrl": "http://localhost:5295"
  },
  "Authentication": {
    // true：啟動先向 IdP 取 token。false：略過登入。
    "Enabled": false,
    // Interactive：開瀏覽器人員登入。ClientCredentials：用 client_id／secret 自動換票。
    "Flow": "ClientCredentials",
    // IdP issuer 基底。
    "Authority": "https://idpapi.csbcnet.com.tw",
    // 在 IdP 登錄的 Client Id（與 Api 的 ClientId 可以不同組）。
    "ClientId": "73a05119",
    // 換 token、refresh 用。甲方 IdP 需 client_secret_basic。
    "ClientSecret": "51f3197f-867d-41a6-bf65-40498af724da",
    // 僅 Interactive：本機 loopback，須事先在 IdP Client 登錄。
    "RedirectUri": "http://127.0.0.1:5005/",
    // Interactive 的 scope；含 offline_access 才通常有 refresh_token。
    "Scope": "openid profile email offline_access",
    // Client Credentials 專用 scope；空白則沿用 Scope。
    "ClientCredentialsScope": "",
    // 給 Api 驗 JWT aud 用；Api 端 Audience 空白時可留空。
    "Audience": "",
    // true：IdP metadata 必須走 HTTPS。
    "RequireHttpsMetadata": true
  }
}
