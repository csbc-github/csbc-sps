<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.15.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThreeDScan.Infrastructure\ThreeDScan.Infrastructure.csproj" />
    <ProjectReference Include="..\ThreeDScan.Lj3DViewHost\ThreeDScan.Lj3DViewHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DAS.Authentication">
      <HintPath>..\libs\DAS.Authentication\DAS.Authentication.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DAS.Repository">
      <HintPath>..\libs\DAS.Authentication\DAS.Repository.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DAS.Core.Shared">
      <HintPath>..\libs\DAS.Authentication\DAS.Core.Shared.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DAS.Models">
      <HintPath>..\libs\DAS.Authentication\DAS.Models.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LMXLidarDriver">
      <HintPath>libs\LMXLidarDriver.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
