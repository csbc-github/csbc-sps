<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        色彩系統（Light Mode 初版）
        依 SD §10.1：綠 = 正常／完成；黃 = 警告；紅 = 異常；SA NFR-U-01：紅黃綠三色區分告警。
        Dark Mode 視後續擴充（SD §10 規定兩種配色）。
    -->

    <!-- 基底 -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#FAFAFA</Color>
    <Color x:Key="SurfaceAltColor">#F3F4F6</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- 文字 -->
    <Color x:Key="TextPrimaryColor">#1F2937</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextInverseColor">#FFFFFF</Color>

    <!-- 狀態色：綠 / 黃 / 紅 / 資訊 -->
    <Color x:Key="SuccessBgColor">#DCFCE7</Color>
    <Color x:Key="SuccessTextColor">#16A34A</Color>
    <Color x:Key="WarningBgColor">#FEF9C3</Color>
    <Color x:Key="WarningTextColor">#CA8A04</Color>
    <Color x:Key="ErrorBgColor">#FEE2E2</Color>
    <Color x:Key="ErrorTextColor">#DC2626</Color>
    <Color x:Key="InfoBgColor">#E5E7EB</Color>
    <Color x:Key="InfoTextColor">#6B7280</Color>

    <!-- 互動 -->
    <Color x:Key="ActiveTabBgColor">#1F2937</Color>
    <Color x:Key="ActiveTabTextColor">#FFFFFF</Color>
    <Color x:Key="HoverColor">#F3F4F6</Color>
    <!-- 2D/3D 切換選中用的中灰 -->
    <Color x:Key="ToggleActiveBgColor">#D1D5DB</Color>

    <!-- 色階（Z 軸 10~60 mm） -->
    <Color x:Key="ScaleHighColor">#FDE047</Color>
    <Color x:Key="ScaleMidColor">#2DD4BF</Color>
    <Color x:Key="ScaleLowColor">#4338CA</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}"/>
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="{StaticResource InfoTextColor}"/>

    <SolidColorBrush x:Key="ActiveTabBgBrush" Color="{StaticResource ActiveTabBgColor}"/>
    <SolidColorBrush x:Key="ActiveTabTextBrush" Color="{StaticResource ActiveTabTextColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="ToggleActiveBgBrush" Color="{StaticResource ToggleActiveBgColor}"/>

</ResourceDictionary>
