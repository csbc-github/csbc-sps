{
  // 僅開發環境覆寫 appsettings.json 對應鍵。
  "Calibration": {
    // 開發時顯示校正監看 Tab。
    "ResponseMode": "Debug"
  },
  "CalibrationMonitor": {
    // 開發時視窗載入後連本機 Hub。
    "Enabled": true
  },
  "Authentication": {
    // 開發時啟動會向 IdP 換票（ClientCredentials）。本機不測登入可改 false。
    "Enabled": true,
    "Flow": "ClientCredentials"
  }
}
