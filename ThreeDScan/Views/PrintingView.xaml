<UserControl x:Class="ThreeDScan.Views.PrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ThreeDScan.Controls"
             xmlns:conv="clr-namespace:ThreeDScan.Converters"
             xmlns:vm="clr-namespace:ThreeDScan.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PrintingViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1200" d:DesignHeight="720">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:SystemStatusToLampBrushConverter x:Key="LampBrushConv"/>
    </UserControl.Resources>

    <controls:AdaptiveSplitView Background="{StaticResource BackgroundBrush}"
                                Threshold="820"
                                PrimaryRatio="2" SecondaryRatio="1"
                                PrimaryMinWidth="460" SecondaryMinWidth="300"
                                PrimaryMinHeight="280" SecondaryMinHeight="240">
        <controls:AdaptiveSplitView.PrimaryContent>
            <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                    <!-- [可隱藏] 噴印區操作按鈕：於此 StackPanel 或各 Button 設 Visibility="Collapsed" -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="開始掃描" Padding="14,6" Margin="0,0,6,0"
                                Command="{Binding StartScanCommand}"/>
                        <Button Content="停止" Padding="14,6" Margin="0,0,6,0"
                                Command="{Binding StopScanCommand}"/>
                        <Button Content="測試載入 3D 檔" Padding="14,6"
                                ToolTip="可載入 PLY（點雲）或 GLB（網格），切換上方模式比對視覺效果"
                                Command="{Binding TestLoadPointCloudCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <RadioButton Content="2D 高度圖" GroupName="PrintingViewMode"
                                     IsChecked="{Binding Is2DMode}"
                                     Style="{StaticResource ToggleButtonStyle}"/>
                        <RadioButton Content="3D 點雲" GroupName="PrintingViewMode"
                                     IsChecked="{Binding Is3DMode}"
                                     Style="{StaticResource ToggleButtonStyle}" Margin="6,0,0,0"/>
                        <RadioButton Content="3D GLB" GroupName="PrintingViewMode"
                                     IsChecked="{Binding IsGlbMode}"
                                     Style="{StaticResource ToggleButtonStyle}" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <controls:ChartToolBar DockPanel.Dock="Top" Margin="0,0,0,8"/>

                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding OverallStatus, Converter={StaticResource LampBrushConv}}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScanStatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastPlyPath}"
                                   Margin="18,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <controls:PreviewPlaceholder
                        Visibility="{Binding Is2DMode, Converter={StaticResource BoolToVis}}"
                        Title="2D 高度圖"
                        SubTitle="噴印區面掃描（UC-04）"/>
                    <controls:PointCloudViewport
                        Visibility="{Binding Is3DMode, Converter={StaticResource BoolToVis}}"
                        Vertices="{Binding PointCloudVertices}"/>
                    <controls:GlbMeshViewport
                        Visibility="{Binding IsGlbMode, Converter={StaticResource BoolToVis}}"
                        GlbPath="{Binding GlbPath}"/>
                </Grid>
            </DockPanel>
        </controls:AdaptiveSplitView.PrimaryContent>

        <controls:AdaptiveSplitView.SecondaryContent>
            <Border Background="{StaticResource SurfaceBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="座標資訊"
                               Style="{StaticResource PanelTitleStyle}" Margin="16,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <controls:CoordinatePanel
                            MachineCoord="{Binding MachineCoordinate}"
                            WorkpieceCoord="{Binding WorkpieceCoordinate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </controls:AdaptiveSplitView.SecondaryContent>
    </controls:AdaptiveSplitView>
</UserControl>
