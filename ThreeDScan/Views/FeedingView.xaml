<UserControl x:Class="ThreeDScan.Views.FeedingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ThreeDScan.Controls"
             xmlns:conv="clr-namespace:ThreeDScan.Converters"
             xmlns:vm="clr-namespace:ThreeDScan.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FeedingViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1200" d:DesignHeight="720">
    <UserControl.Resources>
        <conv:SystemStatusToLampBrushConverter x:Key="LampBrushConv"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 統計資訊列 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="邊緣偵測面積：" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="總計 " Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding TotalArea, StringFormat={}{0:N3}}" FontWeight="Bold"/>
                    <TextBlock Text=" mm²"/>
                    <TextBlock Text="{Binding ContourCount, StringFormat=' ({0} 輪廓)'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 自適應分割：寬 → 左右；窄 → 上下 -->
        <controls:AdaptiveSplitView Grid.Row="1"
                                    Threshold="820"
                                    PrimaryRatio="2" SecondaryRatio="1"
                                    PrimaryMinWidth="460" SecondaryMinWidth="320"
                                    PrimaryMinHeight="280" SecondaryMinHeight="260">
            <controls:AdaptiveSplitView.PrimaryContent>
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="設定掃描區域" Padding="14,6" Margin="0,0,6,0"
                                Command="{Binding BeginSelectRegionCommand}"/>
                        <Button Content="清除掃描區域" Padding="14,6"
                                Command="{Binding ClearRegionCommand}"/>
                    </StackPanel>
                    <controls:LidarScanView Frame="{Binding CurrentFrame}"
                                            Hint="{Binding LiveHint}"
                                            Materials="{Binding Materials}"
                                            IsSelectingRegion="{Binding IsSelectingRegion}"
                                            SensorRegion="{Binding SensorRegion}"
                                            RegionChosen="OnRegionChosen"/>
                </DockPanel>
            </controls:AdaptiveSplitView.PrimaryContent>

            <controls:AdaptiveSplitView.SecondaryContent>
                <Border Background="{StaticResource SurfaceBrush}">
                    <DockPanel>
                        <!-- 標題 -->
                        <DockPanel DockPanel.Dock="Top" Margin="16,12" LastChildFill="False">
                            <TextBlock Text="物料尺寸數據" Style="{StaticResource PanelTitleStyle}"/>
                            <controls:StatusBadge DockPanel.Dock="Right" Text="{Binding LineResultHeadline}" BadgeType="Info"/>
                        </DockPanel>

                        <!-- 底部：掃描狀態 -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="16,12" Background="{StaticResource BackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="掃描狀態" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding LineOverallStatus, Converter={StaticResource LampBrushConv}}"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LineResultStatusText}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 物料清單 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0">
                            <ItemsControl ItemsSource="{Binding LineResults}" Margin="0,8,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:MaterialCard Item="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </controls:AdaptiveSplitView.SecondaryContent>
        </controls:AdaptiveSplitView>
    </Grid>
</UserControl>
