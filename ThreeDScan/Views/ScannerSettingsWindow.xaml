<Window x:Class="ThreeDScan.Views.ScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:ThreeDScan.Converters"
        Title="掃描器拍攝參數" Width="900" Height="860"
        MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <sys:Double x:Key="FormFieldHeight">32</sys:Double>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="{StaticResource FormFieldHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource FormFieldHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="FormToggleFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="{StaticResource FormFieldHeight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="FormReadOnlyFieldBorderStyle" TargetType="Border" BasedOn="{StaticResource FormToggleFieldBorderStyle}"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <DockPanel Margin="16" IsEnabled="{Binding IsFormEnabled}">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,12,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="從資料庫還原" Padding="16,6" Margin="0,0,8,0"
                            Command="{Binding RestoreFromDatabaseCommand}"
                            ToolTip="載入該群組的資料庫備份至畫面（需先「套用並 Save」建立備份）"/>
                    <Button Content="從控制器讀取" Padding="16,6" Margin="0,0,8,0"
                            Command="{Binding LoadFromControllerCommand}"/>
                    <Button Content="套用並 Save" Padding="16,6" FontWeight="SemiBold"
                            Command="{Binding SaveToControllerCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 掃描器與群組 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="掃描器與群組"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="掃描器" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ScannerIds}"
                              SelectedItem="{Binding SelectedScannerId}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="群組" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="ListLabel"/>
                </StackPanel>

                <!-- 感光特性 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="感光特性"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="動態範圍 (1～9)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Form.DynamicRange, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 光量設定 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="光量設定"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="曝光時間" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Form.ExposureTimeOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Form.ExposureTimeIndex}"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="光量控制 — 控制模式" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Form.LightControlModeOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Form.LightControlMode}"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="光量控制 — 上限值 (1～99)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Form.LightControlUpper, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Form.IsLightControlRangeEditable}"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="光量控制 — 下限值 (1～99)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Form.LightControlLower, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Form.IsLightControlRangeEditable}"/>
                </StackPanel>

                <!-- 峰值處理 -->
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="峰值處理"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="峰值檢測靈敏度 (1～5)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Form.PeakDetectionSensitivity, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="8" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="半透明體峰值處理" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource FormToggleFieldBorderStyle}">
                        <CheckBox Content="啟用"
                                  IsChecked="{Binding Form.TranslucentPeakProcessing}"
                                  VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 複數峰值時處理 -->
                <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="複數峰值時處理"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="10" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="光暈過濾器" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource FormToggleFieldBorderStyle}">
                        <CheckBox Content="啟用"
                                  IsChecked="{Binding Form.HaloFilterEnabled}"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="光暈過濾器強度 (1～5)" Margin="0,10,0,4"/>
                    <ComboBox ItemsSource="{Binding Form.HaloFilterStrengthOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Form.HaloFilterStrength}"
                              IsEnabled="{Binding Form.HaloFilterEnabled}"/>
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="峰值選擇" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Form.PeakSelectionOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Form.PeakSelection}"/>
                </StackPanel>

                <!-- 死角數據差補 -->
                <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="死角數據差補"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="12" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="插補模式" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Form.DeadZoneInterpolationOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Form.DeadZoneInterpolation}"/>
                </StackPanel>

                <!-- 間隔倍數 -->
                <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="間隔倍數"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"
                           Margin="0,0,0,8"/>
                <StackPanel Grid.Row="14" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Y 方向間隔倍數" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Form.YIntervalMultiplierOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Form.YIntervalMultiplier}"/>
                </StackPanel>
                <StackPanel Grid.Row="14" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Y 方向數據間隔" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource FormReadOnlyFieldBorderStyle}">
                        <TextBlock Text="{Binding YDataIntervalDisplay}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Text="欄位對齊 Navigator 拍攝參數（不含 PC 圖像過濾）。「從控制器讀取／從資料庫還原」僅更新畫面；「套用並 Save」才寫入攝影機並備份至資料庫。"/>
            </Grid>
        </ScrollViewer>
        </DockPanel>

        <Border Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="{Binding IsBusy}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="處理中，請稍候…"
                           Foreground="White"
                           FontSize="{StaticResource FontSizeMedium}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#EEEEEE"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
