<Window x:Class="ThreeDScan.Views.ScannerTestScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lj3d="clr-namespace:ThreeDScan.Lj3DViewHost;assembly=ThreeDScan.Lj3DViewHost"
        Title="測試掃描" Width="1100" Height="720"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="執行測試掃描" Padding="16,6" FontWeight="SemiBold"
                            Command="{Binding ScanCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding GeometryText}" TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               FontFamily="Consolas"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="測試掃描"
                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Text="{Binding HelpText}"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="掃描器" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ScannerIds}"
                              SelectedItem="{Binding SelectedScannerId}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="群組" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="ListLabel"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <Grid>
                <lj3d:Lj3DViewportHost x:Name="Lj3DHost"/>
                <TextBlock Text="3D 預覽（Lj3DView）&#x0a;執行測試掃描後顯示"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           x:Name="ViewportPlaceholder"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
