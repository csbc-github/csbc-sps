<UserControl x:Class="ThreeDScan.Views.GrindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ThreeDScan.Controls"
             xmlns:conv="clr-namespace:ThreeDScan.Converters"
             xmlns:vm="clr-namespace:ThreeDScan.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GrindingViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1200" d:DesignHeight="680">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
    </UserControl.Resources>

    <controls:AdaptiveSplitView Background="{StaticResource BackgroundBrush}"
                                Threshold="820"
                                PrimaryRatio="2" SecondaryRatio="1"
                                PrimaryMinWidth="460" SecondaryMinWidth="340"
                                PrimaryMinHeight="280" SecondaryMinHeight="260">
        <controls:AdaptiveSplitView.PrimaryContent>
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="3D 點雲與選取孔緣（來源 PLY 座標）"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="綠色標記：封閉孔緣　橘色標記：部分開口"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                </StackPanel>

                <Grid>
                    <controls:PreviewPlaceholder
                        Visibility="{Binding HasPointCloud, Converter={StaticResource BoolToVisInvert}}"
                        Title="尚無點雲"
                        SubTitle=""/>
                    <controls:PointCloudViewport
                        Visibility="{Binding HasPointCloud, Converter={StaticResource BoolToVis}}"
                        Vertices="{Binding PointCloudVertices}"
                        HighlightPoints="{Binding ScannerBoundaryPoints}"
                        HighlightIsClosed="{Binding SelectedFeatureIsClosed}"/>
                </Grid>
            </DockPanel>
        </controls:AdaptiveSplitView.PrimaryContent>

        <controls:AdaptiveSplitView.SecondaryContent>
            <Border Background="{StaticResource SurfaceBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                        <TextBlock Text="孔洞量測結果" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="{Binding MeasurementSourceCaption}" ToolTip="{Binding MeasurementSourceTooltip}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock Text="{Binding ScopeStatus}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding HoleSummary}" Margin="0,8,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CoordinateStatus}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                        <ComboBox ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}"
                                  DisplayMemberPath="Label" IsEnabled="{Binding HasFeatureSelections}"
                                  AutomationProperties.Name="選取孔洞或部分開口" MinHeight="32"/>
                        <TextBlock Text="{Binding SelectedFeatureStatus}" TextWrapping="Wrap" Margin="0,8,0,12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="孔緣 XYZ（絕對座標 mm）"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PathPoints.Count, StringFormat={}{0} 點}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding PathPoints}"
                              SelectedItem="{Binding SelectedPathPoint}"
                              Margin="16,0,16,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="節點" Binding="{Binding NodeId}" Width="64"/>
                            <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:F2}}" Width="*"/>
                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:F2}}" Width="*"/>
                            <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, StringFormat={}{0:F2}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </controls:AdaptiveSplitView.SecondaryContent>
    </controls:AdaptiveSplitView>
</UserControl>
