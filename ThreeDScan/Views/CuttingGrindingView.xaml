<UserControl x:Class="ThreeDScan.Views.CuttingGrindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:ThreeDScan.Views"
             xmlns:conv="clr-namespace:ThreeDScan.Converters"
             xmlns:vm="clr-namespace:ThreeDScan.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CuttingGrindingViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1200" d:DesignHeight="720">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <!-- 子 Tab：割切 / 研磨 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="割切 (Cutting)" GroupName="CuttingGrindingSubTab"
                             IsChecked="{Binding IsCuttingTab}"
                             Style="{StaticResource PillToggleButtonStyle}"/>
                <RadioButton Content="研磨 (Grinding)" GroupName="CuttingGrindingSubTab"
                             IsChecked="{Binding IsGrindingTab}"
                             Style="{StaticResource PillToggleButtonStyle}" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid>
            <views:CuttingView
                Visibility="{Binding IsCuttingTab, Converter={StaticResource BoolToVis}}"
                DataContext="{Binding CuttingVM}"/>
            <views:GrindingView
                Visibility="{Binding IsGrindingTab, Converter={StaticResource BoolToVis}}"
                DataContext="{Binding GrindingVM}"/>
        </Grid>
    </DockPanel>
</UserControl>
