<Window x:Class="ThreeDScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ThreeDScan.Views"
        xmlns:vm="clr-namespace:ThreeDScan.ViewModels"
        xmlns:conv="clr-namespace:ThreeDScan.Converters"
        mc:Ignorable="d"
        Title="3D 掃描應用服務 — 監看介面"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <conv:WidthGreaterThanConverter x:Key="WidthGteConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 工廠圖示（Material Design Icons: factory, Apache 2.0） -->
        <Geometry x:Key="FactoryIconGeometry">M2,20V8H5V6H7V8H10V5H13V8L17,4L21,8V20H2M4,18H19V9.26L17,7.46L15,9.26V12H12V10H10V12H7V10H4V18M6,14V16H8V14H6M11,14V16H13V14H11M15,14V16H17V14H15Z</Geometry>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 標題列：系統名稱 7 ／ 掃描參數 3（窄視窗時隱藏副標） -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 左 70%：工廠圖示 + 系統名稱 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource SurfaceAltBrush}"
                            Margin="0,0,12,0">
                        <Viewbox Width="22" Height="22">
                            <Path Data="{StaticResource FactoryIconGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="3D 掃描應用服務"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="角鋼產線量測 · 監看介面"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                        Path=ActualWidth,
                                                        Converter={StaticResource WidthGteConv},
                                                        ConverterParameter=900}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右 30%：掃描參數 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="掃描參數"
                            Padding="14,6" Margin="0,0,8,0"
                            Click="OnOpenScannerSettings"
                            ToolTip="調整 LJ-X 拍攝參數並 Save 至控制器"/>
                    <Button Content="測試掃描"
                            Padding="14,6" Margin="0,0,8,0"
                            Click="OnOpenScannerTestScan"
                            ToolTip="選擇群組並擷取一幀高度／灰階預覽（不做角鋼後處理）"/>
                    <Button Content="群組名稱"
                            Padding="14,6"
                            Click="OnOpenScannerGroupNames"
                            ToolTip="編輯各群組的顯示名稱"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab 導覽 + 內容（SD §10.6 UI-02 / UI-03 / UI-04） -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MainTabControlStyle}"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="預備進料">
                <views:FeedingView DataContext="{Binding FeedingVM}"/>
            </TabItem>
            <TabItem Header="噴印區">
                <views:PrintingView DataContext="{Binding PrintingVM}"/>
            </TabItem>
            <TabItem Header="割切研磨區">
                <views:CuttingGrindingView DataContext="{Binding CuttingGrindingVM}"/>
            </TabItem>
            <TabItem Header="校正監看"
                     Visibility="{Binding ShowCalibrationMonitorTab, Converter={StaticResource BoolToVis}}">
                <views:CalibrationMonitorView DataContext="{Binding CalibrationMonitorVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
