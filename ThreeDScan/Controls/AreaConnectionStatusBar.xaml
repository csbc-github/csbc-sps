<UserControl x:Class="ThreeDScan.Controls.AreaConnectionStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ThreeDScan.Converters"
             xmlns:models="clr-namespace:ThreeDScan.Models"
             x:Name="Root">
    <UserControl.Resources>
        <conv:SystemStatusToLampBrushConverter x:Key="LampBrushConv"/>
    </UserControl.Resources>
    <Border Padding="10,8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10"
                         Fill="{Binding ConnectionLamp, ElementName=Root, Converter={StaticResource LampBrushConv}}"
                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ConnectionStatusText, ElementName=Root}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <ContentPresenter Content="{Binding DetailContent, ElementName=Root}" Margin="18,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
