<UserControl x:Class="ThreeDScan.Controls.LidarScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThreeDScan.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             Background="Transparent"
             Focusable="True"
             ClipToBounds="True"
             d:DesignWidth="800" d:DesignHeight="500">
    <!--
        進料區掃描視覺化（仿介面草稿 01_進料區_light.jpg）
        - 折線圖：X-SCAN DISTANCE (mm) ／ Z-PROFILE HEIGHT (mm)
        - 由 LidarScanRenderer 自動以資料範圍縮放
        - 物料分區半透明色塊（依 Materials 集合的左/右角點 X 位置）
        - 滑鼠 hover 顯示 X / Z 座標
    -->
    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True"
            Background="{StaticResource BackgroundBrush}">

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Z (mm)"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="2,0,6,0"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- 主繪圖區 -->
            <local:LidarScanRenderer x:Name="Renderer"
                                     Grid.Row="0" Grid.Column="1"
                                     ClipToBounds="True"/>

            <Canvas x:Name="DragLayer"
                    Grid.Row="0" Grid.Column="1"
                    IsHitTestVisible="False">
                <Rectangle x:Name="DragRect"
                           Visibility="Collapsed"
                           Stroke="#2563EB"
                           StrokeThickness="1.6"
                           StrokeDashArray="6 3"
                           Fill="#332563EB"/>
            </Canvas>

            <!-- 空狀態提示（疊在 Renderer 之上） -->
            <StackPanel x:Name="EmptyHint"
                        Grid.Row="0" Grid.Column="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="LiDAR 即時掃描 — 高度剖面圖"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Hint, ElementName=Root}"
                           FontSize="{StaticResource FontSizeSmall}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- X 軸標題 -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="X-SCAN DISTANCE (mm)"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,2"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- 滑鼠座標 readout -->
            <TextBlock x:Name="ReadoutText"
                       Grid.Row="2" Grid.Column="1"
                       Margin="6,4,6,0"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="X: —   Z: —   滑鼠移入顯示座標"/>
        </Grid>
    </Border>
</UserControl>
