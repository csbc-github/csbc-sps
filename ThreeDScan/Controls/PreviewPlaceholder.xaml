<UserControl x:Class="ThreeDScan.Controls.PreviewPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root">
    <!--
        預覽佔位：依本階段規劃，2D 高度剖面與 3D 點雲區以示意圖帶過。
        ImageSource 若為 null，顯示內建虛框 + 圖徵文字。
    -->
    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8FAFC" Offset="0"/>
                <GradientStop Color="#EEF2FF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Image Source="{Binding ImageSource, ElementName=Root}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding PlaceholderVisibility, ElementName=Root}">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding SubTitle, ElementName=Root}"
                           FontSize="{StaticResource FontSizeSmall}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="（請放入實際示意圖 / 日後接入 2D／3D 繪圖）"
                           FontSize="{StaticResource FontSizeSmall}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
