<UserControl x:Class="ThreeDScan.Controls.HeadFeaturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ThreeDScan.Converters"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
        <Style x:Key="AxisCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="AxisHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="AxisValueStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas,Microsoft JhengHei UI"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,12,3"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas,Microsoft JhengHei UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="16" Background="Transparent">
        <Grid>
            <TextBlock Text="尚無前緣特徵（載入掃描 GLB 後顯示）"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Features.HasData, ElementName=Root, Converter={StaticResource BoolToVisInvert}}"/>

            <StackPanel Visibility="{Binding Features.HasData, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="左邊角" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Features.LeftCorner, ElementName=Root}"
                               Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="頂點" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Features.Apex, ElementName=Root}"
                               Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="右邊角" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding Features.RightCorner, ElementName=Root}"
                               Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="左側厚度" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding Features.ThicknessLeft, ElementName=Root, StringFormat={}{0:F2} mm, TargetNullValue=—, FallbackValue=—}"
                               Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="右側厚度" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding Features.ThicknessRight, ElementName=Root, StringFormat={}{0:F2} mm, TargetNullValue=—, FallbackValue=—}"
                               Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Z 軸差" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding Features.RidgeZDelta, ElementName=Root, StringFormat={}{0:F2} mm, TargetNullValue=—, FallbackValue=—}"
                               Style="{StaticResource FieldValue}"/>
                </Grid>

                <TextBlock Text="包圍盒（與 2D 圖同一軸）" Style="{StaticResource PanelTitleStyle}"
                           FontSize="{StaticResource FontSizeMedium}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AxisCardStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="X (mm)" Style="{StaticResource AxisHeaderStyle}"/>
                            <TextBlock Style="{StaticResource AxisValueStyle}"
                                       Text="{Binding Features.SizeX, ElementName=Root, StringFormat={}{0:F1}, TargetNullValue=—, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource AxisCardStyle}" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Y (mm)" Style="{StaticResource AxisHeaderStyle}"/>
                            <TextBlock Style="{StaticResource AxisValueStyle}"
                                       Text="{Binding Features.SizeY, ElementName=Root, StringFormat={}{0:F1}, TargetNullValue=—, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AxisCardStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Z (mm)" Style="{StaticResource AxisHeaderStyle}"/>
                            <TextBlock Style="{StaticResource AxisValueStyle}"
                                       Text="{Binding Features.SizeZ, ElementName=Root, StringFormat={}{0:F1}, TargetNullValue=—, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
